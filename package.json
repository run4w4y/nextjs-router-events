{
  "name": "@nextjs-router-events/workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target build --all",
    "lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target lint --all",
    "lint:fix": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target lint:fix --all",
    "typecheck": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target typecheck --all",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target test --all",
    "test:unit": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target test:unit --all",
    "test:e2e": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run-many --target test:e2e --all",
    "pack:check": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false node ./node_modules/nx/bin/nx.js run nextjs-router-events:pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@eslint/js": "9.27.0",
    "@happy-dom/global-registrator": "20.9.0",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/workspace": "22.6.5",
    "@playwright/test": "1.59.1",
    "@rslib/core": "^0.17.0",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "bun-types": "1.3.12",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "^16.5.0",
    "happy-dom": "20.9.0",
    "nx": "22.6.5",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  }
}
